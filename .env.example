# Postgres (локально поднимается через `npm run db:up`)
POSTGRES_USER=kmf
POSTGRES_PASSWORD=kmf
POSTGRES_DB=kmf
DATABASE_URL=postgres://kmf:kmf@localhost:5432/kmf

# Секрет Payload: сгенерировать `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=change-me

# Публичный адрес сайта (для SEO, ссылок в письмах)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
